{
  "name": "@theama/desktop",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Electron shell for Theama: window, native menus, service control and the typed IPC bridge.",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "service": "tsx src/main/service/admin-cli.ts",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "dist": "node ../../tools/package/stage.mjs && electron-builder --config electron-builder.yml --win nsis --x64",
    "pack:dir": "node ../../tools/package/stage.mjs && electron-builder --config electron-builder.yml --win --x64 --dir",
    "test:packaged": "playwright test -c playwright.packaged.config.ts"
  },
  "dependencies": {
    "@theama/contracts": "workspace:*",
    "@theama/logs": "workspace:*",
    "electron-updater": "6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
