{
  "name": "theama",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Θέαμα — a personal cinematic media library for Windows",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docs:setup": "tsx tools/setup-docs.ts",
    "dev": "node tools/dev.mjs",
    "build": "yarn workspaces foreach -A --topological run build",
    "typecheck": "yarn workspaces foreach -A --topological run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:release": "node --test tools/package/release.test.mjs",
    "test:e2e": "yarn workspace @theama/ui run build && yarn workspace @theama/desktop run test:e2e",
    "icons": "yarn workspace @theama/brand run build",
    "service:install": "yarn workspace @theama/desktop run service install",
    "service:uninstall": "yarn workspace @theama/desktop run service uninstall",
    "nssm:fetch": "node tools/nssm/fetch-nssm.mjs",
    "service:repair": "yarn workspace @theama/desktop run service repair",
    "dev:server": "yarn workspace @theama/server run dev",
    "ffprobe:fetch": "node tools/ffprobe/fetch-ffprobe.mjs",
    "tmdb:fake": "node tools/fake-tmdb/server.mjs",
    "perf": "tsx tools/perf/perf.ts",
    "dist": "yarn build && yarn workspace @theama/desktop run dist",
    "dist:signed": "node tools/package/signing.mjs check && yarn dist && node tools/package/signing.mjs verify",
    "release": "node tools/package/release.mjs",
    "verify:signature": "node tools/package/signing.mjs verify",
    "pack:dir": "yarn build && yarn workspace @theama/desktop run pack:dir",
    "test:packaged": "yarn pack:dir && yarn workspace @theama/desktop run test:packaged"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.2.0"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": false
    },
    "electron": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "sharp": {
      "built": true
    }
  }
}
